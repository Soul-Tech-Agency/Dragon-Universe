{
 "namespace": "du2_detail",
 "detail_form@du2.root": {
  "controls": [{"pc@du2_detail.pc": {"ignored": "$du2_mobile"}}, {"mobile@du2_detail.mobile": {"ignored": "$du2_pc"}}]
 },
 "scroll_pc": {
  "type": "stack_panel",
  "orientation": "vertical",
  "size": ["100%", "100%c"],
  "controls": [
   {
    "body": {
     "type": "label",
     "text": "#form_text",
     "size": ["100%", "default"],
     "color": [0.902, 0.925, 0.969],
     "font_type": "smooth",
     "shadow": false,
     "text_alignment": "left"
    }
   }
  ]
 },
 "pc": {
  "type": "panel",
  "size": [400, 240],
  "max_size": ["100% - 8px", "100% - 8px"],
  "anchor_from": "center",
  "anchor_to": "center",
  "layer": 1,
  "controls": [
   {"bg": {"type": "image", "texture": "textures/ui/du2/panel_main", "size": ["100%", "100%"]}},
   {
    "col": {
     "type": "stack_panel",
     "orientation": "vertical",
     "size": ["100%", "100%"],
     "controls": [
      {
       "title": {
        "type": "panel",
        "size": ["100%", 24],
        "controls": [
         {"bg": {"type": "image", "texture": "textures/ui/du2/title_bar", "size": ["100%", "100%"]}},
         {"row@du2_detail.h2": {}}
        ]
       }
      },
      {"body": {"type": "panel", "size": ["100%", "fill"], "controls": [{"inner@du2_detail.h6": {}}]}}
     ]
    }
   }
  ]
 },
 "scroll_mobile": {
  "type": "stack_panel",
  "orientation": "vertical",
  "size": ["100%", "100%c"],
  "controls": [
   {
    "body": {
     "type": "label",
     "text": "#form_text",
     "size": ["100%", "default"],
     "color": [0.902, 0.925, 0.969],
     "font_type": "smooth",
     "shadow": false,
     "text_alignment": "left"
    }
   }
  ]
 },
 "mobile": {
  "type": "panel",
  "size": ["100% - 6px", "100% - 6px"],
  "max_size": [480, 270],
  "anchor_from": "center",
  "anchor_to": "center",
  "layer": 1,
  "controls": [
   {"bg": {"type": "image", "texture": "textures/ui/du2/panel_main", "size": ["100%", "100%"]}},
   {
    "col": {
     "type": "stack_panel",
     "orientation": "vertical",
     "size": ["100%", "100%"],
     "controls": [
      {
       "title": {
        "type": "panel",
        "size": ["100%", 20],
        "controls": [
         {"bg": {"type": "image", "texture": "textures/ui/du2/title_bar", "size": ["100%", "100%"]}},
         {"row@du2_detail.h7": {}}
        ]
       }
      },
      {"body": {"type": "panel", "size": ["100%", "fill"], "controls": [{"inner@du2_detail.h8": {}}]}}
     ]
    }
   }
  ]
 },
 "h1@common.button": {
  "size": [24, 20],
  "collection_index": 0,
  "$pressed_button_name": "button.form_button_click",
  "default_control": "default",
  "hover_control": "hover",
  "pressed_control": "pressed",
  "controls": [
   {
    "default": {
     "type": "panel",
     "size": ["100%", "100%"],
     "controls": [
      {"bg": {"type": "image", "texture": "textures/ui/du2/btn_secondary", "size": ["100%", "100%"]}},
      {
       "i": {
        "type": "image",
        "texture": "textures/ui/du2/icons/back",
        "size": [10, 10],
        "color": [0.965, 0.725, 0.263]
       }
      }
     ]
    }
   },
   {
    "hover": {
     "type": "panel",
     "size": ["100%", "100%"],
     "controls": [
      {"bg": {"type": "image", "texture": "textures/ui/du2/btn_secondary_hover", "size": ["100%", "100%"]}},
      {
       "i": {
        "type": "image",
        "texture": "textures/ui/du2/icons/back",
        "size": [10, 10],
        "color": [0.965, 0.725, 0.263]
       }
      }
     ]
    }
   },
   {
    "pressed": {
     "type": "panel",
     "size": ["100%", "100%"],
     "controls": [
      {"bg": {"type": "image", "texture": "textures/ui/du2/btn_secondary_pressed", "size": ["100%", "100%"]}},
      {
       "i": {
        "type": "image",
        "texture": "textures/ui/du2/icons/back",
        "size": [10, 10],
        "color": [0.965, 0.725, 0.263]
       }
      }
     ]
    }
   }
  ],
  "bindings": [
   {"binding_type": "collection_details", "binding_collection_name": "form_buttons"},
   {
    "binding_type": "collection",
    "binding_collection_name": "form_buttons",
    "binding_name": "#form_button_text"
   },
   {
    "binding_type": "view",
    "source_property_name": "(#form_button_text = 'ui.dbe.backButton')",
    "target_property_name": "#visible"
   }
  ]
 },
 "h2": {
  "type": "stack_panel",
  "orientation": "horizontal",
  "size": ["100%", "100%"],
  "controls": [
   {"pad": {"type": "panel", "size": [3, "100%"]}},
   {
    "back": {
     "type": "panel",
     "size": [24, "100%"],
     "controls": [
      {
       "h": {
        "type": "panel",
        "size": [24, 20],
        "collection_name": "form_buttons",
        "controls": [{"b@du2_detail.h1": {}}],
        "anchor_from": "center",
        "anchor_to": "center"
       }
      }
     ]
    }
   },
   {"pad": {"type": "panel", "size": [3, "100%"]}},
   {"logo": {"type": "panel", "size": [24, "100%"], "controls": [{"logo@du2.logo": {}}]}},
   {"pad": {"type": "panel", "size": [4, "100%"]}},
   {
    "title": {
     "type": "panel",
     "size": ["fill", "100%"],
     "clips_children": true,
     "controls": [{"t@du2.title_label": {}}]
    }
   },
   {"pad": {"type": "panel", "size": [4, "100%"]}},
   {
    "close": {
     "type": "panel",
     "size": [18, "100%"],
     "controls": [{"b@du2.close_button": {"size": [18, 18], "anchor_from": "center", "anchor_to": "center"}}]
    }
   },
   {"pad": {"type": "panel", "size": [3, "100%"]}}
  ]
 },
 "h3": {
  "type": "panel",
  "size": [12, 12],
  "controls": [
   {
    "i_play": {
     "type": "image",
     "texture": "textures/ui/du2/icons/play",
     "size": [10, 10],
     "color": [0.047, 0.09, 0.188],
     "bindings": [
      {
       "binding_type": "collection",
       "binding_collection_name": "form_buttons",
       "binding_name": "#form_button_text"
      },
      {
       "binding_type": "view",
       "source_property_name": "(#form_button_text = 'ui.dbe.quest.button.start')",
       "target_property_name": "#visible"
      }
     ]
    }
   },
   {
    "i_restart": {
     "type": "image",
     "texture": "textures/ui/du2/icons/restart",
     "size": [10, 10],
     "color": [0.047, 0.09, 0.188],
     "bindings": [
      {
       "binding_type": "collection",
       "binding_collection_name": "form_buttons",
       "binding_name": "#form_button_text"
      },
      {
       "binding_type": "view",
       "source_property_name": "(#form_button_text = 'ui.dbe.quest.button.restart')",
       "target_property_name": "#visible"
      }
     ]
    }
   }
  ],
  "anchor_from": "center",
  "anchor_to": "center"
 },
 "h4": {
  "type": "stack_panel",
  "orientation": "horizontal",
  "size": ["100%", "100%"],
  "controls": [
   {"pad": {"type": "panel", "size": [8, "100%"]}},
   {"cell": {"type": "panel", "size": [12, "100%"], "controls": [{"x@du2_detail.h3": {}}]}},
   {"pad": {"type": "panel", "size": [4, "100%"]}},
   {
    "t": {
     "type": "panel",
     "size": ["fill", "100%"],
     "clips_children": true,
     "controls": [
      {
       "l": {
        "type": "label",
        "text": "#du2_text",
        "size": ["100%", 10],
        "color": [0.047, 0.09, 0.188],
        "font_type": "smooth",
        "shadow": false,
        "text_alignment": "center",
        "bindings": [
         {
          "binding_type": "collection",
          "binding_collection_name": "form_buttons",
          "binding_name": "#form_button_text"
         },
         {
          "binding_type": "view",
          "source_property_name": "(#form_button_text - '*')",
          "target_property_name": "#du2_text"
         }
        ],
        "anchor_from": "center",
        "anchor_to": "center"
       }
      }
     ]
    }
   },
   {"pad": {"type": "panel", "size": [8, "100%"]}}
  ]
 },
 "h5@common.button": {
  "size": [130, 22],
  "collection_index": 1,
  "$pressed_button_name": "button.form_button_click",
  "default_control": "default",
  "hover_control": "hover",
  "pressed_control": "pressed",
  "controls": [
   {
    "default": {
     "type": "panel",
     "size": ["100%", "100%"],
     "controls": [
      {"bg": {"type": "image", "texture": "textures/ui/du2/btn_primary", "size": ["100%", "100%"]}},
      {"row@du2_detail.h4": {}}
     ]
    }
   },
   {
    "hover": {
     "type": "panel",
     "size": ["100%", "100%"],
     "controls": [
      {"bg": {"type": "image", "texture": "textures/ui/du2/btn_primary_hover", "size": ["100%", "100%"]}},
      {"row@du2_detail.h4": {}}
     ]
    }
   },
   {
    "pressed": {
     "type": "panel",
     "size": ["100%", "100%"],
     "controls": [
      {"bg": {"type": "image", "texture": "textures/ui/du2/btn_primary_pressed", "size": ["100%", "100%"]}},
      {"row@du2_detail.h4": {}}
     ]
    }
   }
  ],
  "bindings": [
   {"binding_type": "collection_details", "binding_collection_name": "form_buttons"},
   {
    "binding_type": "collection",
    "binding_collection_name": "form_buttons",
    "binding_name": "#form_button_text"
   },
   {
    "binding_type": "view",
    "source_property_name": "(not ((#form_button_text = '') or (#form_button_text = 'ui.dbe.backButton')))",
    "target_property_name": "#visible"
   }
  ]
 },
 "h6": {
  "type": "stack_panel",
  "orientation": "vertical",
  "size": ["100% - 12px", "100% - 10px"],
  "anchor_from": "center",
  "anchor_to": "center",
  "controls": [
   {
    "scroll": {
     "type": "panel",
     "size": ["100%", "fill"],
     "controls": [
      {
       "s@common.scrolling_panel": {
        "anchor_to": "top_left",
        "anchor_from": "top_left",
        "size": ["100%", "100%"],
        "$show_background": false,
        "$scrolling_content": "du2_detail.scroll_pc",
        "$scroll_size": [4, "100% - 2px"],
        "$scrolling_pane_size": ["100% - 6px", "100%"],
        "$scrolling_pane_offset": [0, 0],
        "$scroll_bar_right_padding_size": [0, 0]
       }
      }
     ]
    }
   },
   {"pad": {"type": "panel", "size": ["100%", 4]}},
   {
    "bottom": {
     "type": "stack_panel",
     "orientation": "horizontal",
     "size": ["100%", 22],
     "controls": [
      {"fill": {"type": "panel", "size": ["fill", "100%"]}},
      {
       "action": {
        "type": "panel",
        "size": [130, 22],
        "collection_name": "form_buttons",
        "controls": [{"b@du2_detail.h5": {}}]
       }
      }
     ]
    }
   }
  ]
 },
 "h7": {
  "type": "stack_panel",
  "orientation": "horizontal",
  "size": ["100%", "100%"],
  "controls": [
   {"pad": {"type": "panel", "size": [3, "100%"]}},
   {
    "back": {
     "type": "panel",
     "size": [24, "100%"],
     "controls": [
      {
       "h": {
        "type": "panel",
        "size": [24, 20],
        "collection_name": "form_buttons",
        "controls": [{"b@du2_detail.h1": {}}],
        "anchor_from": "center",
        "anchor_to": "center"
       }
      }
     ]
    }
   },
   {"pad": {"type": "panel", "size": [3, "100%"]}},
   {"logo": {"type": "panel", "size": [20, "100%"], "controls": [{"logo@du2.logo": {}}]}},
   {"pad": {"type": "panel", "size": [4, "100%"]}},
   {
    "title": {
     "type": "panel",
     "size": ["fill", "100%"],
     "clips_children": true,
     "controls": [{"t@du2.title_label": {}}]
    }
   },
   {"pad": {"type": "panel", "size": [4, "100%"]}},
   {
    "close": {
     "type": "panel",
     "size": [22, "100%"],
     "controls": [{"b@du2.close_button": {"size": [22, 20], "anchor_from": "center", "anchor_to": "center"}}]
    }
   },
   {"pad": {"type": "panel", "size": [3, "100%"]}}
  ]
 },
 "h8": {
  "type": "stack_panel",
  "orientation": "vertical",
  "size": ["100% - 8px", "100% - 6px"],
  "anchor_from": "center",
  "anchor_to": "center",
  "controls": [
   {
    "scroll": {
     "type": "panel",
     "size": ["100%", "fill"],
     "controls": [
      {
       "s@common.scrolling_panel": {
        "anchor_to": "top_left",
        "anchor_from": "top_left",
        "size": ["100%", "100%"],
        "$show_background": false,
        "$scrolling_content": "du2_detail.scroll_mobile",
        "$scroll_size": [4, "100% - 2px"],
        "$scrolling_pane_size": ["100% - 6px", "100%"],
        "$scrolling_pane_offset": [0, 0],
        "$scroll_bar_right_padding_size": [0, 0]
       }
      }
     ]
    }
   },
   {"pad": {"type": "panel", "size": ["100%", 4]}},
   {
    "bottom": {
     "type": "stack_panel",
     "orientation": "horizontal",
     "size": ["100%", 22],
     "controls": [
      {"fill": {"type": "panel", "size": ["fill", "100%"]}},
      {
       "action": {
        "type": "panel",
        "size": [130, 22],
        "collection_name": "form_buttons",
        "controls": [{"b@du2_detail.h5": {}}]
       }
      }
     ]
    }
   }
  ]
 }
}
