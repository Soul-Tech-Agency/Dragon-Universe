{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "dbe:mental_replica_aura",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/mental_wisp"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 10,
				"max_particles": 18
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1.1
			},
			"minecraft:emitter_shape_disc": {
				"offset": [
					0,
					0.1,
					0
				],
				"radius": "(v.radius > 0 ? v.radius : 0.7)",
				"plane_normal": [
					0,
					1,
					0
				],
				"surface_only": true,
				"direction": [
					0,
					1,
					0
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "1.3 + v.particle_random_1 * 0.4"
			},
			"minecraft:particle_initial_speed": "(v.height > 0 ? v.height : 2.0) / 1.5",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					"math.sin(v.particle_age * 240 + v.particle_random_2 * 360) * 0.6",
					0,
					"math.cos(v.particle_age * 240 + v.particle_random_2 * 360) * 0.6"
				],
				"linear_drag_coefficient": 0.6
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.16 * (1 - v.particle_age / v.particle_lifetime * 0.7)",
					"0.16 * (1 - v.particle_age / v.particle_lifetime * 0.7)"
				],
				"facing_camera_mode": "rotate_xyz"
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": [
							0.61,
							0.42,
							1.0,
							0.0
						],
						"0.2": [
							0.61,
							0.42,
							1.0,
							0.7
						],
						"0.6": [
							0.35,
							0.66,
							1.0,
							0.55
						],
						"1.0": [
							0.35,
							0.66,
							1.0,
							0.0
						]
					}
				}
			}
		}
	}
}
