{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "dbe:concentration_orb_off",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/concentration_orb_off"
			}
		},
		"components": {
			// Orbe apagado do treino de concentração (dbe:training_orb com dbe:color 3): anel vazado #8FA0BF a ~45%.
			// Preso à entidade pelo RP (training_orb.entity.json): dura enquanto o orbe existir e some com ele.
			// Se o script soltar com spawnParticle, v.age (s) encerra o emissor, como o dbe:concentration_orb.
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 4,
				"max_particles": 2
			},
			"minecraft:emitter_lifetime_expression": {
				"activation_expression": 1,
				"expiration_expression": "v.emitter_age >= (v.age ?? 3600)"
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, 0.0625, 0]
			},
			// 2 vivas, cada uma com rampa triangular de alfa defasada em meio ciclo: a soma fica quase constante (respiração leve)
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.5
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.125, 0.125],
				"facing_camera_mode": "rotate_xyz"
			},
			"minecraft:particle_appearance_tinting": {
				"color": [0.561, 0.627, 0.749, "0.45 * (1 - math.abs(2 * v.particle_age / 0.5 - 1))"]
			}
		}
	}
}
