{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "dbe:mental_exit",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/mental_wisp"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 36
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.1
			},
			"minecraft:emitter_shape_box": {
				"offset": [
					0,
					"(v.height > 0 ? v.height : 2.0) / 2",
					0
				],
				"half_dimensions": [
					"(v.radius > 0 ? v.radius : 0.7) * 0.8",
					"(v.height > 0 ? v.height : 2.0) / 2",
					"(v.radius > 0 ? v.radius : 0.7) * 0.8"
				],
				"direction": [
					0,
					1,
					0
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "0.9 + v.particle_random_1 * 0.5"
			},
			"minecraft:particle_initial_speed": "0.3 + v.particle_random_2 * 0.5",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					0,
					2.0,
					0
				],
				"linear_drag_coefficient": 1.2
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.2 * (1 - v.particle_age / v.particle_lifetime)",
					"0.2 * (1 - v.particle_age / v.particle_lifetime)"
				],
				"facing_camera_mode": "rotate_xyz"
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": [
							0.61,
							0.42,
							1.0,
							0.8
						],
						"0.5": [
							0.35,
							0.66,
							1.0,
							0.6
						],
						"1.0": [
							0.92,
							0.88,
							1.0,
							0.0
						]
					}
				}
			}
		}
	}
}
