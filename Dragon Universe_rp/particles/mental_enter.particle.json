{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "dbe:mental_enter",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/mental_shard"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 40
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.1
			},
			"minecraft:emitter_shape_disc": {
				"offset": [
					0,
					0.15,
					0
				],
				"radius": 0.4,
				"plane_normal": [
					0,
					1,
					0
				],
				"surface_only": true,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "0.8 + v.particle_random_1 * 0.3"
			},
			"minecraft:particle_initial_speed": "2.2 + (v.radius > 0 ? v.radius : 0.7) * 1.5",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					0,
					"1.5 + v.particle_random_2 * 1.5",
					0
				],
				"linear_drag_coefficient": 2.2
			},
			"minecraft:particle_initial_spin": {
				"rotation": "v.particle_random_3 * 360",
				"rotation_rate": 120
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.18 * (1 - v.particle_age / v.particle_lifetime)",
					"0.18 * (1 - v.particle_age / v.particle_lifetime)"
				],
				"facing_camera_mode": "rotate_xyz"
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": [
							0.92,
							0.88,
							1.0,
							0.95
						],
						"0.35": [
							0.61,
							0.42,
							1.0,
							0.85
						],
						"1.0": [
							0.35,
							0.66,
							1.0,
							0.0
						]
					}
				}
			}
		}
	}
}
