{
    "format_version": "1.10.0",
    "minecraft:client_entity": {
        "description": {
            "identifier": "dbe:training_orb",
            "materials": {
                "default": "entity_alphatest"
            },
            "textures": {
                "default": "textures/empty"
            },
            "geometry": {
                "default": "geometry.none"
            },
            "render_controllers": [ "controller.render.default" ],
            // dbe:color 3 = orbe apagado (concentração): o anel vazado vem daqui, o script não solta partícula para ele
            "particle_effects": {
                "orb_off": "dbe:concentration_orb_off"
            },
            "animations": {
                "orb_off_controller": "controller.animation.dbe.training_orb"
            },
            "scripts": {
                "animate": [ "orb_off_controller" ]
            }
        }
    }
}